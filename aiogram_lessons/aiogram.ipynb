    "    \"    await message.answer('Write smth, ill answer')\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"@dp.message()\\n\",\n",
    "    \"async def send_echo(message: Message):\\n\",\n",
    "    \"    await message.reply(text=message.text)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"if __name__ == '__main__':\\n\",\n",
    "    \"    dp.run_polling(bot)\"\n",
