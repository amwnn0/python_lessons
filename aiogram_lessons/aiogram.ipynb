    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"load_dotenv()\\n\",\n",
    "    \"BOT_TOKEN = os.getenv('TOKEN')\\n\",\n",
    "    \"bot = Bot(token=BOT_TOKEN)\\n\",\n",
    "    \"dp = Dispatcher()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"@dp.message(Command(commands='start'))\\n\",\n",
