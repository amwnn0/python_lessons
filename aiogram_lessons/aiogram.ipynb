    "   \"source\": [\n",
    "    \"def custom_filter(some_list: list) -> bool:\\n\",\n",
    "    \"    cnt = 0\\n\",\n",
    "    \"    for item in some_list:\\n\",\n",
    "    \"        if type(item) == int and item % 7 == 0:\\n\",\n",
    "    \"            cnt += item\\n\",\n",
    "    \"    return True if cnt <= 83 else False\\n\"\n",
